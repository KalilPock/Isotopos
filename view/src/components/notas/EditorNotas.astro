<main class="flex-1 flex flex-col bg-[#1e1e1e] relative">
  <!-- TELA 1: Placeholder de nota vazia -->
  <div id="tela-vazia" class="flex-1 flex flex-col items-center justify-center text-zinc-500">
    <svg class="w-16 h-16 mb-4 text-zinc-700/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
    </svg>
    <h2 class="text-xl font-medium text-zinc-400">Nenhuma nota aberta</h2>
    <p class="text-sm mt-2 text-zinc-600">Selecione um arquivo na barra lateral para começar.</p>
  </div>

  <!-- TELA 2: O Editor de Texto -->
  <div id="tela-editor" class="hidden flex-1 flex-col p-6 h-full">
    <div class="flex items-center justify-between mb-4 border-b border-zinc-800 pb-4">
      <input type="text" id="editor-titulo" class="bg-transparent text-2xl font-semibold text-zinc-100 outline-none w-full placeholder-zinc-700" placeholder="Título da nota..." />
      <button id="btn-salvar-nota" class="ml-4 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm transition-colors flex items-center gap-2 whitespace-nowrap shadow-lg shadow-blue-900/20">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
        </svg>
        <span id="texto-btn-salvar">Salvar</span>
      </button>
    </div>
    <textarea id="editor-conteudo" class="flex-1 bg-transparent text-zinc-300 outline-none resize-none placeholder-zinc-700 font-mono text-sm leading-relaxed" placeholder="Escreva o conteúdo da sua nota aqui..."></textarea>
  </div>
</main>