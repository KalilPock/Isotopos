---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

const { title = "Isótopos" } = Astro.props;
---

<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <ClientRouter />
  </head>
  <body class="bg-zinc-950 text-slate-200 font-sans m-0 min-h-screen">
    <slot />

    <!-- Modal Criar Nova Nota -->
    <div
      id="modal-nova-nota"
      class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4"
    >
      <div
        class="bg-gray-900 border border-gray-800 rounded-xl p-6 w-full max-w-md shadow-2xl space-y-4"
      >
        <div class="flex justify-between items-center">
          <h3 class="text-lg font-bold text-white">Criar Nova Nota</h3>
          <button
            id="btn-fechar-x"
            class="text-gray-400 hover:text-white transition-colors">✕</button
          >
        </div>

        <div>
          <label
            for="input-titulo-nota"
            class="block text-xs font-medium text-gray-400 mb-1 uppercase tracking-wider"
          >
            Título da Nota
          </label>
          <input
            type="text"
            id="input-titulo-nota"
            placeholder="Ex: Anotações da Reunião"
            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors"
            autocomplete="off"
          />
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <button
            id="btn-cancelar-modal"
            type="button"
            class="px-4 py-2 text-sm text-gray-400 hover:text-white transition-colors"
          >
            Cancelar
          </button>
          <button
            id="btn-confirmar-modal"
            type="button"
            class="px-4 py-2 text-sm bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-lg transition-colors flex items-center gap-2"
          >
            Criar
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Criar Nova Pasta -->
    <div
      id="modal-nova-pasta"
      class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4"
    >
      <div
        class="bg-gray-900 border border-gray-800 rounded-xl p-6 w-full max-w-md shadow-2xl space-y-4"
      >
        <div class="flex justify-between items-center">
          <h3 id="titulo-modal-pasta" class="text-lg font-bold text-white">
            Criar Nova Pasta
          </h3>
          <button
            id="btn-fechar-modal-pasta"
            type="button"
            class="text-gray-400 hover:text-white transition-colors"
            aria-label="Fechar modal"
          >✕</button>
        </div>

        <div>
          <label
            for="input-nome-pasta"
            class="block text-xs font-medium text-gray-400 mb-1 uppercase tracking-wider"
          >
            Nome da Pasta
          </label>
          <input
            type="text"
            id="input-nome-pasta"
            placeholder="Ex: Projetos"
            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 transition-colors"
            autocomplete="off"
          />
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <button
            id="btn-cancelar-modal-pasta"
            type="button"
            class="px-4 py-2 text-sm text-gray-400 hover:text-white transition-colors"
          >
            Cancelar
          </button>
          <button
            id="btn-confirmar-modal-pasta"
            type="button"
            class="px-4 py-2 text-sm bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-lg transition-colors flex items-center gap-2"
          >
            Criar
          </button>
        </div>
      </div>
    </div>
    <script>
      // Registra handlers tanto no carregamento inicial quanto em navegações client-side
      function registerGlobalHandlers() {
        // 1. Lógica Global do Menu Hambúrguer
        const btnMenu = document.getElementById("btn-menu");
        const sidebar = document.getElementById("sidebar");

        if (btnMenu && sidebar && !btnMenu.dataset.menuHandler) {
          btnMenu.addEventListener("click", () => {
            // O .toggle() adiciona a classe se ela não existir, e remove se existir
            sidebar.classList.toggle("hidden");
            sidebar.classList.toggle("flex");
          });
          btnMenu.dataset.menuHandler = "1";
        }

        // 2. Lógica Global do Botão de Sair (Logout)
        const btnSair = document.getElementById("btn-sair");
        if (btnSair && !btnSair.dataset.logoutHandler) {
          btnSair.addEventListener("click", () => {
            localStorage.removeItem("eva_token");
            window.location.href = "/";
          });
          btnSair.dataset.logoutHandler = "1";
        }
      }

      document.addEventListener("DOMContentLoaded", registerGlobalHandlers);
      document.addEventListener("astro:page-load", registerGlobalHandlers);
    </script>
  </body>
</html>
