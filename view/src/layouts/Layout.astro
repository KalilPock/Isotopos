---
// Importação CRUCIAL para o Tailwind funcionar nas páginas que usam este Layout
import '../styles/global.css';

const { title = 'Isótopos' } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <!-- O fundo escuro padrão já pode ficar no body do layout -->
  <body class="bg-zinc-950 text-slate-200 font-sans m-0 min-h-screen">
    <slot />
  </body>
</html>