---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Painel de Configurações - Isótopos">

    <main class="flex-1 p-8">
      <header class="flex justify-between items-center mb-10">
        
        <!-- Agrupando o botão hambúrguer com o título -->
        <div class="flex items-center gap-4">
          <!-- Botão Menu Hambúrguer -->
          <button id="btn-menu" class="p-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white rounded-lg transition-colors cursor-pointer" title="Alternar Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          
          <div>
            <h1 class="text-3xl font-bold text-white">Configurações</h1>
            <p class="text-zinc-400 mt-1">Opções gerais</p>
          </div>
        </div>
        
        <!-- Avatar do Usuário -->
        <div class="h-12 w-12 bg-purple-600 rounded-full flex items-center justify-center font-bold text-white shadow-lg shadow-purple-900/50">
          K
        </div>
      </header>

      <!-- Grid de Indicadores (Cards) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Card 1:  -->
        <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 shadow-sm">
          <h3 class="text-zinc-400 font-medium text-sm uppercase tracking-wider">Aguardando...</h3>
          <div class="flex items-center mt-3">
            <div class="h-3 w-3 bg-emerald-500 rounded-full animate-pulse mr-3"></div>
            <p class="text-2xl font-bold text-emerald-400">Aguardando...</p>
          </div>
        </div>

        <!-- Card 2:  -->
        <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 shadow-sm">
          <h3 class="text-zinc-400 font-medium text-sm uppercase tracking-wider">Aguardando...</h3>
          <div class="flex items-center mt-3">
            <div class="h-3 w-3 bg-blue-500 rounded-full mr-3"></div>
            <p class="text-2xl font-bold text-blue-400">Aguardando...</p>
          </div>
        </div>
        
        <!-- Card 3:  -->
        <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 shadow-sm">
          <h3 class="text-zinc-400 font-medium text-sm uppercase tracking-wider">Aguardando...</h3>
          <div class="mt-3">
            <p class="text-lg font-medium text-purple-400 truncate" id="info-usuario">Aguardando...</p>
          </div>
        </div>

      </div>
    </main>


<script>
    
</script>  

</Layout>
