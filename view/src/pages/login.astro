---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Login - Isótopos">
  <!-- Adicionado 'h-screen' e 'items-center' para centralizar verticalmente -->
  <main class="w-full h-screen flex justify-center items-center p-6">
    <form
      id="form-login"
      method="POST"
      action=""
      class="w-full max-w-[420px] bg-zinc-900 border border-eva-purple/40 rounded-2xl p-8 sm:px-7 shadow-2xl shadow-eva-purple/10"
    >
      <!-- Título em verde neon -->
      <h1 class="text-center text-3xl mb-6 font-bold text-eva-green">Login</h1>

      <div class="flex flex-col gap-2 mb-5">
        <label class="font-semibold text-slate-300" for="usuario">Usuário</label
        >
        <!-- Foco do input muda para a cor verde do Evangelion -->
        <input
          class="w-full p-3 border border-zinc-700 rounded-lg bg-zinc-800 text-slate-200 outline-none transition-all duration-200 placeholder:text-zinc-500 focus:border-eva-green focus:ring-[3px] focus:ring-eva-green/20"
          type="text"
          name="usuario"
          id="usuario"
          placeholder="Digite seu usuário"
        />
      </div>

      <div class="flex flex-col gap-2 mb-5">
        <label class="font-semibold text-slate-300" for="senha">Senha</label>
        <input
          class="w-full p-3 border border-zinc-700 rounded-lg bg-zinc-800 text-slate-200 outline-none transition-all duration-200 placeholder:text-zinc-500 focus:border-eva-green focus:ring-[3px] focus:ring-eva-green/20"
          type="password"
          name="senha"
          id="senha"
          placeholder="Digite sua senha"
        />
      </div>

      <!-- Classe corrigida de text-eva-gresen para text-eva-green -->
      <button
        class="w-full p-3 border-none rounded-lg bg-eva-purple text-eva-green font-bold text-lg tracking-wide cursor-pointer transition-all duration-200 hover:-translate-y-[2px] hover:bg-opacity-90 hover:shadow-lg hover:shadow-eva-purple/30 mt-2"
        type="submit"
      >
        Entrar
      </button>

      <!-- Link para Cadastro -->
      <div class="mt-5 text-center">
        <a
          href="/cadastro"
          class="text-sm text-zinc-400 hover:text-eva-green transition-colors"
        >
          Não possui uma conta? Faça seu cadastro
        </a>
      </div>
    </form>
  </main>

  <script>
  // Esta função garante que o script só roda quando o Astro terminar de desenhar a tela
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("form-login");

    form?.addEventListener("submit", async (evento) => {
      // ISSO AQUI CANCELA O ENVIO PELA URL! Tem que ser a primeira linha.
      evento.preventDefault();

      const usuarioInput = document.getElementById("usuario") as HTMLInputElement;
      const senhaInput = document.getElementById("senha") as HTMLInputElement;

      // Validação rápida para evitar enviar campos vazios
      if (!usuarioInput.value || !senhaInput.value) {
        alert("Preencha todos os campos!");
        return;
      }

      const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

      try {
        const resposta = await fetch(`${API_URL}/api/login`, {
          method: "POST", // Aqui a senha vai escondida no corpo (Body)
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            usuario: usuarioInput.value, 
            senha: senhaInput.value 
          }),
        });

        const dados = await resposta.json();

        if (resposta.ok) {
          localStorage.setItem("eva_token", dados.token);
          window.location.href = "/painel";
        } else {
          alert(dados.mensagem || "Erro ao fazer login");
        }
      } catch (erro) {
        console.error("Erro:", erro);
        alert("O servidor backend está offline.");
      }
    });
  });
</script>
</Layout>
