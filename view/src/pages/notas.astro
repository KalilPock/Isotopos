---
import PainelLayout from "../layouts/PainelLayout.astro";
import SidebarNotas from "../components/notas/SidebarNotas.astro";
import EditorNotas from "../components/notas/EditorNotas.astro";
import ModalsNotas from "../components/notas/ModalsNotas.astro";
---

<PainelLayout title="Notas - Isótopos">
  <div class="relative min-w-0 w-full min-h-[calc(100dvh-180px)] md:h-[calc(100dvh-150px)] border border-zinc-800 rounded-xl bg-[#1e1e1e] text-zinc-300 flex overflow-hidden font-sans shadow-2xl">
    <button id="btn-menu-notas" class="absolute top-3 left-3 z-20 md:hidden p-2 bg-zinc-800 text-zinc-300 rounded-lg" title="Abrir lista de notas" aria-label="Abrir lista de notas">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <SidebarNotas />
    <EditorNotas />
  </div>
  <ModalsNotas />

  <!-- Script limpo integrado com o ciclo de vida do View Transitions do Astro -->
  <script>
    import { iniciarGerenciadorNotas } from "../scripts/notasController.js";

    document.addEventListener("astro:page-load", () => {
      iniciarGerenciadorNotas();

      const btnAbrir = document.getElementById("btn-menu-notas");
      const btnFechar = document.getElementById("btn-fechar-sidebar-notas");
      const sidebar = document.getElementById("sidebar-notas");

      if (!btnAbrir || !btnFechar || !sidebar || sidebar.dataset.menuHandler) return;

      const alternarSidebar = (aberta: boolean) => {
        sidebar.classList.toggle("-translate-x-full", !aberta);
      };

      btnAbrir.addEventListener("click", () => alternarSidebar(true));
      btnFechar.addEventListener("click", () => alternarSidebar(false));
      sidebar.dataset.menuHandler = "1";
    });
  </script>
</PainelLayout>