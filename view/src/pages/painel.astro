---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Painel de Controle - Isótopos">
  <div class="min-h-screen bg-zinc-950 text-slate-200 flex flex-col md:flex-row">
    
    <!-- Sidebar / Menu Lateral (Adicionado id="sidebar") -->
    <aside id="sidebar" class="w-full md:w-64 bg-zinc-900 border-r border-zinc-800 flex flex-col">
      <div class="p-6 border-b border-zinc-800">
        <h2 class="text-2xl font-black text-purple-500 tracking-wider">ISÓTOPOS</h2>
      </div>
      
      <nav class="flex-1 p-4 space-y-2">
        <a href="/painel" class="block px-4 py-2 bg-purple-600/10 text-purple-400 rounded-lg border border-purple-500/20 transition-all">
          Visão Geral
        </a>
        <a href="/notas" class="block px-4 py-2 hover:bg-zinc-800 text-zinc-400 hover:text-slate-200 rounded-lg transition-all">
          Anotações globais
        </a>
        <a href="#" class="block px-4 py-2 hover:bg-zinc-800 text-zinc-400 hover:text-slate-200 rounded-lg transition-all">
          Usuários
        </a>
        <a href="#" class="block px-4 py-2 hover:bg-zinc-800 text-zinc-400 hover:text-slate-200 rounded-lg transition-all">
          Configurações
        </a>
      </nav>

      <div class="p-6 border-t border-zinc-800">
        <button id="btn-sair" class="w-full px-4 py-2 bg-zinc-800 hover:bg-red-600/90 text-zinc-300 hover:text-white rounded-lg transition-colors font-medium">
          Desconectar
        </button>
      </div>
    </aside>

    <!-- Conteúdo Principal -->
    <main class="flex-1 p-8">
      <header class="flex justify-between items-center mb-10">
        
        <!-- Agrupando o botão hambúrguer com o título -->
        <div class="flex items-center gap-4">
          <!-- Botão Menu Hambúrguer -->
          <button id="btn-menu" class="p-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white rounded-lg transition-colors cursor-pointer" title="Alternar Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
          
          <div>
            <h1 class="text-3xl font-bold text-white">Dashboard</h1>
            <p class="text-zinc-400 mt-1">Bem-vindo ao centro de comando do sistema.</p>
          </div>
        </div>
        
        <!-- Avatar do Usuário -->
        <div class="h-12 w-12 bg-purple-600 rounded-full flex items-center justify-center font-bold text-white shadow-lg shadow-purple-900/50">
          U
        </div>
      </header>

      <!-- Grid de Indicadores (Cards) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Card 1: Status da API -->
        <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 shadow-sm">
          <h3 class="text-zinc-400 font-medium text-sm uppercase tracking-wider">Status do Servidor</h3>
          <div class="flex items-center mt-3">
            <div class="h-3 w-3 bg-emerald-500 rounded-full animate-pulse mr-3"></div>
            <p class="text-2xl font-bold text-emerald-400">Online</p>
          </div>
        </div>

        <!-- Card 2: Banco de Dados -->
        <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 shadow-sm">
          <h3 class="text-zinc-400 font-medium text-sm uppercase tracking-wider">Supabase DB</h3>
          <div class="flex items-center mt-3">
            <div class="h-3 w-3 bg-blue-500 rounded-full mr-3"></div>
            <p class="text-2xl font-bold text-blue-400">Conectado</p>
          </div>
        </div>

        <!-- Card 3: Sessão -->
        <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 shadow-sm">
          <h3 class="text-zinc-400 font-medium text-sm uppercase tracking-wider">Sessão Atual</h3>
          <div class="mt-3">
            <p class="text-lg font-medium text-purple-400 truncate" id="info-usuario">Verificando credenciais...</p>
          </div>
        </div>

      </div>
    </main>
  </div>

  <script>
    // Lógica para o Menu Hambúrguer
    document.getElementById('btn-menu')?.addEventListener('click', () => {
      const sidebar = document.getElementById('sidebar');
      
      // Trava de segurança: se o sidebar não for encontrado, para a função aqui.
      if (!sidebar) return;
      
      // O Tailwind precisa que a gente remova o 'flex' quando adicionamos o 'hidden'
      if (sidebar.classList.contains('hidden')) {
        sidebar.classList.remove('hidden');
        sidebar.classList.add('flex');
      } else {
        sidebar.classList.add('hidden');
        sidebar.classList.remove('flex');
      }
    });

    // Lógica provisória do botão de Logout
    document.getElementById('btn-sair')?.addEventListener('click', () => {
      localStorage.removeItem('eva_token');
      window.location.href = '/';
    });
  </script>
</Layout>