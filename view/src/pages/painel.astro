---
import PainelLayout from "../layouts/PainelLayout.astro";
---

<PainelLayout title="Dashboard - Isótopos">
  <!-- Todo o menu e o header sumiram daqui! Ficam só os cards -->

  <!-- Grid de Indicadores (Cards) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Card 1: Status da API -->
    <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 shadow-sm">
      <h3 class="text-zinc-400 font-medium text-sm uppercase tracking-wider">
        Status do Servidor
      </h3>
      <div class="flex items-center mt-3">
        <div class="h-3 w-3 bg-emerald-500 rounded-full animate-pulse mr-3">
        </div>
        <p class="text-2xl font-bold text-emerald-400">Online</p>
      </div>
    </div>

    <!-- Card 2: Banco de Dados -->
    <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 shadow-sm">
      <h3 class="text-zinc-400 font-medium text-sm uppercase tracking-wider">
        Supabase DB
      </h3>
      <div class="flex items-center mt-3">
        <div class="h-3 w-3 bg-blue-500 rounded-full mr-3"></div>
        <p class="text-2xl font-bold text-blue-400">Conectado</p>
      </div>
    </div>

    <!-- Card 3: Sessão -->
    <div class="bg-zinc-900 p-6 rounded-xl border border-zinc-800 shadow-sm">
      <h3 class="text-zinc-400 font-medium text-sm uppercase tracking-wider">
        Sessão Atual
      </h3>
      <div class="mt-3">
        <p
          class="text-lg font-medium text-purple-400 truncate"
          id="info-usuario"
        >
          Verificando credenciais...
        </p>
      </div>
    </div>
  </div>
  <script>
  // Lógica provisória do botão de Logout
  document.getElementById("btn-sair")?.addEventListener("click", () => {
    localStorage.removeItem("eva_token");
    window.location.href = "/";
  });
</script>

</PainelLayout>

